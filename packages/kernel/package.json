{
  "name": "@cvpw/kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-side render core: time expressions, timebase, seeded RNG, layers, camera, plugin registry. No runtime dependencies, no Node globals.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  }
}
