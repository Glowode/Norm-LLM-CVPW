{
  "name": "@cvpw/audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static audit for the frame-drawing path: AST-based determinism rules, UTF-8/encoding integrity, absolute-time and layout-literal warnings.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
