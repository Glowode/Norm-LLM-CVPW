{
  "name": "@cvpw/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DOM-free scene and timeline loader, so validation and storyboard generation run in Node without a browser.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cvpw/kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
