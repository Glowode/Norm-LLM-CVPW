{
  "name": "norm-llm-cvpw",
  "version": "0.1.0",
  "private": true,
  "description": "Normalized, agent-agnostic framework for producing video from code.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r --filter \"./packages/**\" lint",
    "cvpw": "node packages/cli/bin/cvpw.mjs",
    "doctor": "node packages/cli/bin/cvpw.mjs doctor",
    "spike:determinism": "node scripts/determinism-spike.mjs",
    "spike:session": "node scripts/determinism-session.mjs",
    "spike:repeat": "node scripts/determinism-repeat.mjs",
    "spike:chunks": "node scripts/determinism-chunks.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glowode/Norm-LLM-CVPW.git"
  },
  "homepage": "https://github.com/Glowode/Norm-LLM-CVPW#readme",
  "bugs": {
    "url": "https://github.com/Glowode/Norm-LLM-CVPW/issues"
  }
}
